      "Event": {
        "additionalProperties": false,
        "description": "One append-only entry in the workspace log: the source of truth for history and undo.\n\n`before` and `after` hold only the attributes that changed, so swapping them inverts the event.\nEvents sharing a `batch_id` came from one user action and are undone together.",
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "title": "Id",
            "type": "string"
          },
          "workspaceId": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "title": "Workspaceid",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "targetId": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "title": "Targetid",
            "type": "string"
          },
          "actorId": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "title": "Actorid",
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/Origin",
            "default": "user"
          },
          "batchId": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{1,128}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Batchid"
          },
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "before": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Before"
          },
          "after": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "After"
          }
        },
        "required": [
          "id",
          "workspaceId",
          "type",
          "targetId",
          "actorId",
          "origin",
          "batchId",
          "at",
          "before",
          "after"
        ],
