  "rules": [
    {
      "key": "submitted_xp",
      "title": "Reward submissions",
      "enabled": true,
      "when": {
        "on": "item.updated",
        "type": "assignment",
        "where": [
          {
            "field": "status",
            "op": "eq",
            "value": "done"
          }
        ]
      },
      "then": [
        {
          "do": "award",
          "args": {
            "points": 50
          }
        }
      ]
    }
